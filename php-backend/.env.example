# Hardware Store POS & ERP - MySQL Database Configuration (cPanel / Shared Hosting)
# Copy this file to .env and configure with your cPanel MySQL credentials

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hardware_store_db
DB_USER=root
DB_PASS=

# Application Timezone (e.g. Asia/Karachi, UTC, America/New_York)
APP_TIMEZONE=Asia/Karachi

# Session lifetime in seconds (default: 604800 = 7 days)
SESSION_LIFETIME=604800

# Allowed CORS Origins for API (comma-separated, or * for all)
CORS_ORIGINS=*
